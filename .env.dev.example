# Example .env file for development environments
# This can be used directly for development.

# This is the only line really required:
ENV="dev"

# The following are optional, and these are the default values if omitted.
# In production, these are ignored.
DEBUG=True
SECURE_SSL_REDIRECT=False
WHITENOISE_DISABLE=True

# Must be set in prod, but these have fallbacks in dev.
MAIN_HOST=example.com
ALLOWED_HOSTS=example.com,www.example.com,example.org
SECRET_KEY=insecure-dev-key-never-use-in-prod
SECRET_DIR=null/