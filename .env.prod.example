# Example .env file for production environments
# Review and adjust every line before deploying!
ENV="prod"

# All of these must be set manually!
MAIN_HOST=example.com
ALLOWED_HOSTS=example.com,www.example.com,example.org
SECRET_KEY=insecure-dev-key-never-use-in-prod-0123456789ABCDEF
SECRET_DIR=null/